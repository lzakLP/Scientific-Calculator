def somar(a, b):
     total = a + b
     return total
def subtrair(a, b):
     total = a - b
     return total
def multiplicar(a, b):
     total = a * b
     return total
def dividir(a, b):
     total = a / b
     return total

def adicionar_historico(historico, operacao):
     if len(historico) == 5:
         historico.pop(0)

     historico.append(operacao)

historico=[]
executando = True

while executando:

     print("Scientific Calculator")
     opcao = int(input("Escolha sua operação:"))

     if opcao == 1:

         a = float(input("Primeiro Número:"))
         b = float(input("Segundo Número:"))

         resultado = somar(a, b)
         print(f"{resultado:.2f}")
         adicionar_historico(historico, f"{a} / {b} = {resultado:.2f}")

     elif opcao == 2:

         a = float(input("Primeiro Número:"))
         b = float(input("Segundo Número:"))

         resultado = subtrair(a, b)
         print(f"{resultado:.2f}")
         adicionar_historico(historico, f"{a} / {b} = {resultado:.2f}")

     elif opcao == 3:

         a = float(input("Primeiro Número:"))
         b = float(input("Segundo Número:"))

         resultado = multiplicar(a, b)
         print(f"{resultado:.2f}")
         adicionar_historico(historico, f"{a} / {b} = {resultado:.2f}")

     elif opcao == 4:

         a = float(input("Primeiro Número:"))
         b = float(input("Segundo Número:"))

         try:
          resultado = dividir(a, b)
          print(f"{resultado:.2f}")
          adicionar_historico(historico, f"{a} / {b} = {resultado:.2f}")
         except ZeroDivisionError:
          print("Error: Divisão por Zero")

     elif opcao == 11:
         executando = False

     elif opcao == 0:
         print(historico)